# RAOS_COGNITIVE_PROVIDER=rule
# RAOS_LLM_BASE_URL=https://api.openai.com/v1
# RAOS_LLM_API_KEY=
# RAOS_LLM_MODEL=gpt-4o-mini
# RAOS_EMBEDDING_BASE_URL=
# RAOS_EMBEDDING_API_KEY=
# RAOS_EMBEDDING_MODEL=text-embedding-3-small
# RAOS_EMBEDDING_DIMENSIONS=
# RAOS_LLM_INPUT_COST_PER_1M=
# RAOS_LLM_OUTPUT_COST_PER_1M=
# none: omit thinking fields (OpenAI-compatible). deepseek: send thinking/reasoning_effort.
# RAOS_LLM_THINKING_PROTOCOL=none
# RAOS_LLM_THINKING_PROTOCOL=deepseek
# auto: Qwen instruct prefix when embedding model name contains qwen. qwen: always. none: raw query.
# RAOS_EMBEDDING_QUERY_PROTOCOL=auto
# RAOS_DATABASE_URL=sqlite:///./raos.db
# RAOS_DATABASE_URL=postgresql+psycopg://raos:raos@localhost:5432/raos
# RAOS_AUTO_CREATE_TABLES=true
